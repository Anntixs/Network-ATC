<Project Sdk="Microsoft.NET.Sdk">
  <!-- The only assembly a Network-ATC plugin needs to reference. Keep it small and stable. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NetworkAtc.Plugins</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
