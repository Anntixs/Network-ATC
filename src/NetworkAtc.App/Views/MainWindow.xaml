<Window x:Class="NetworkAtc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:radar="clr-namespace:NetworkAtc.App.Radar"
        xmlns:controls="clr-namespace:NetworkAtc.App.Controls"
        Title="Network-ATC" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowState="Maximized" Style="{StaticResource AtcWindow}">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <!-- Top bar laid out like EuroScope: menu keys on the left, the controller's station, the METAR strip,
         then view range and UTC on the right. -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <!-- Wordmark: a framed square and the name, set apart by a hairline. -->
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,0" Height="39">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Network-ATC">
              <Border Width="16" Height="16" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="0,0,9,0">
                <Border Width="5" Height="5" Background="{DynamicResource AccentBrush}"/>
              </Border>
              <TextBlock Text="NETWORK-ATC" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
          </Border>
          <Button x:Name="FileButton" Content="FILE ▾" Style="{StaticResource BarButton}" Click="OnFileClick"
                  ToolTip="Sector, EuroScope profile import, recent sectors"/>
          <ToggleButton x:Name="LayersButton" Content="MAPS" Style="{StaticResource BarToggle}" Click="OnLayersClick" ToolTip="Map layers (F6)"/>
          <Button x:Name="ListsButton" Content="LISTS ▾" Style="{StaticResource BarButton}" Click="OnListsClick"/>
          <Button Content="RWY" Style="{StaticResource BarButton}" Click="OnRunwaysClick" ToolTip="Active airports, runways and ATIS (Ctrl+R)"/>
          <Button x:Name="VoiceButton" Style="{StaticResource BarButton}" Click="OnVoiceClick" ToolTip="Voice: frequencies, push-to-talk, audio">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="VoiceDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock Text="RADIO"/>
            </StackPanel>
          </Button>
          <Button x:Name="AtisButton" Style="{StaticResource BarButton}" Click="OnAtisClick" ToolTip="ATIS stations: text for pilots and voice on air">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="AtisDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="AtisLabel" Text="ATIS"/>
            </StackPanel>
          </Button>
          <Button x:Name="PluginsButton" Content="PLUGINS ▾" Style="{StaticResource BarButton}" Click="OnPluginsClick"
                  ToolTip="Network-ATC plugins and EuroScope plugin data"/>
          <Button Content="SETTINGS" Style="{StaticResource BarButton}" Click="OnSettingsClick"/>
          <Border Width="1" Height="39" Background="{DynamicResource BorderBrush}"/>
          <Button x:Name="ConnectButton" Click="OnConnectClick" Style="{StaticResource BarButton}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnectDot" Width="7" Height="7" Fill="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ConnectText" Text="CONNECT"/>
            </StackPanel>
          </Button>
          <!-- The controller's own station, as in the EuroScope top bar. -->
          <Border x:Name="StationBox" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0" Padding="14,0" Height="39"
                  Visibility="Collapsed">
            <TextBlock x:Name="StationText" Text="" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <!-- Altitude filter, hundreds of feet (EuroScope's filter below / above). -->
          <TextBlock Text="FILTER" Style="{StaticResource Muted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBox x:Name="FilterLowBox" Width="40" Height="22" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                   ToolTip="Hide aircraft below, hundreds of feet (0 = no filter)" KeyDown="OnFilterKeyDown" LostFocus="OnFilterChanged"/>
          <TextBlock Text="–" Style="{StaticResource Muted}" Margin="3,0" VerticalAlignment="Center"/>
          <TextBox x:Name="FilterHighBox" Width="40" Height="22" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                   ToolTip="Hide aircraft above, hundreds of feet" KeyDown="OnFilterKeyDown" LostFocus="OnFilterChanged"/>
          <TextBlock x:Name="SectorText" Text="No sector" Style="{StaticResource Muted}" Margin="10,0,12,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="RangeText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0"/>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16,0" Height="39" Background="{DynamicResource BgBrush}">
            <TextBlock x:Name="ClockText" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </Border>
        </StackPanel>
        <!-- METAR strip of the active airports: ATIS letter, wind and QNH; the full METAR in the tooltip. -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="10,0,0,0" VerticalAlignment="Center">
          <ItemsControl x:Name="WeatherStrip">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,0" Height="24" Margin="0,0,6,0"
                        Background="{DynamicResource BgBrush}" ToolTip="{Binding Raw}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Station}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Atis}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Muted}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Radar with floating list windows -->
    <Grid Grid.Row="1">
      <radar:RadarView x:Name="Radar"/>
      <Canvas x:Name="WindowsLayer">

        <controls:FloatingPanel x:Name="DeparturesWindow" WindowId="departures" Header="DEPARTURES">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/><ColumnDefinition Width="42"/><ColumnDefinition Width="44"/><ColumnDefinition Width="60"/>
                <ColumnDefinition Width="36"/><ColumnDefinition Width="48"/><ColumnDefinition Width="40"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="CALLSIGN" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="2" Text="DEST" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="3" Text="SID" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="4" Text="RWY" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="5" Text="RFL" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="6" Text="SQK" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="7" Text="CLR" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="8" Text="STATUS" Style="{StaticResource ColumnHeader}"/>
            </Grid>
            <ListBox x:Name="DepartureList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76"/><ColumnDefinition Width="42"/><ColumnDefinition Width="44"/><ColumnDefinition Width="60"/>
                      <ColumnDefinition Width="36"/><ColumnDefinition Width="48"/><ColumnDefinition Width="40"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Destination}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Sid}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Runway}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Rfl}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Squawk}"/>
                    <Button Grid.Column="7" Content="{Binding Clearance}" Tag="{Binding Track}" Style="{StaticResource Ghost}" Padding="4,0"
                            Click="OnClearanceClick" ToolTip="Clearance received"/>
                    <TextBlock Grid.Column="8" Text="{Binding Status}" Style="{StaticResource Muted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="ArrivalsWindow" WindowId="arrivals" Header="ARRIVALS">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/><ColumnDefinition Width="42"/><ColumnDefinition Width="46"/><ColumnDefinition Width="60"/>
                <ColumnDefinition Width="36"/><ColumnDefinition Width="54"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="CALLSIGN" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="2" Text="ORIG" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="3" Text="STAR" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="4" Text="RWY" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="5" Text="LEVEL" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="6" Text="NM" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="7" Text="ETA" Style="{StaticResource ColumnHeader}"/>
            </Grid>
            <ListBox x:Name="ArrivalList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76"/><ColumnDefinition Width="42"/><ColumnDefinition Width="46"/><ColumnDefinition Width="60"/>
                      <ColumnDefinition Width="36"/><ColumnDefinition Width="54"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Departure}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Star}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Runway}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Level}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Distance}"/>
                    <TextBlock Grid.Column="7" Text="{Binding Eta}" Style="{StaticResource Muted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="SilWindow" WindowId="sil" Header="INCOMING (SIL)">
          <ListBox x:Name="SilList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected" MouseDoubleClick="OnSilDoubleClick"
                   ToolTip="Double-click to accept handoff">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/><ColumnDefinition Width="40"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Other}" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Level}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Info}" Style="{StaticResource Muted}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="SelWindow" WindowId="sel" Header="OUTGOING (SEL)">
          <ListBox x:Name="SelList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected" MouseDoubleClick="OnSelDoubleClick"
                   ToolTip="Double-click to hand off to next controller">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/><ColumnDefinition Width="46"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Other}" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Level}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Info}" Style="{StaticResource Muted}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="TrafficWindow" WindowId="traffic" Header="ALL TRAFFIC">
          <ListBox x:Name="TrafficList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Level}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Info}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="FlightPlanWindow" WindowId="flightplan" Header="FLIGHT PLAN">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0">
            <StackPanel>
              <TextBlock x:Name="PlanEmpty" Text="Select an aircraft on the radar" Style="{StaticResource Muted}" Margin="2,6"/>
              <StackPanel x:Name="PlanContent" Visibility="Collapsed">
                <DockPanel>
                  <TextBlock x:Name="OwnerText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock x:Name="PlanCallsign" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </DockPanel>
                <TextBlock x:Name="PlanSubtitle" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
                <TextBlock x:Name="PlanRoute" FontSize="15" Margin="0,6,0,0"/>
                <WrapPanel x:Name="CoordButtons" Margin="0,8,0,0"/>

                <TextBlock Text="INSTRUCTIONS" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="CFL" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="CflBox" Tag="cfl" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="Heading" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="HdgBox" Tag="hdg" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="Speed" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="SpdBox" Tag="spd" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="Squawk" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Assign" Padding="6,3" Click="OnAssignSquawk"/>
                      <TextBox x:Name="SqBox" Tag="sq" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                    </DockPanel>
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Scratchpad" Style="{StaticResource FieldLabel}" Margin="0,2,0,2"/>
                <TextBox x:Name="ScratchBox" Tag="scratch" KeyDown="OnAnnotationKeyDown" Padding="6,3"/>

                <TextBlock Text="PROCEDURES" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="SID" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SidBox" Tag="sid" SelectionChanged="OnProcedureChanged" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="STAR" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="StarBox" Tag="star" SelectionChanged="OnProcedureChanged" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="Departure rwy" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="DepRwyBox" Tag="drwy" SelectionChanged="OnProcedureChanged" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="Arrival rwy" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="ArrRwyBox" Tag="arwy" SelectionChanged="OnProcedureChanged" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                </UniformGrid>
                <CheckBox x:Name="ClrBox" Content="Departure clearance received" Click="OnClrBoxClick" Margin="0,2,0,0"/>

                <TextBlock Text="FLIGHT PLAN" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Rules" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpRules" CharacterCasing="Upper" MaxLength="1" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="0,0,0,4">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpType" CharacterCasing="Upper" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Margin="0,0,0,4">
                    <TextBlock Text="TAS" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpTas" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock Text="Departure" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpDep" CharacterCasing="Upper" MaxLength="4" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4">
                    <TextBlock Text="Destination" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpDest" CharacterCasing="Upper" MaxLength="4" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,4">
                    <TextBlock Text="Alternate" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpAltn" CharacterCasing="Upper" MaxLength="4" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock Text="RFL" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpRfl" CharacterCasing="Upper" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,4">
                    <TextBlock Text="Planned departure (UTC)" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="FpTime" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Route" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                <TextBox x:Name="FpRoute" CharacterCasing="Upper" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                <TextBox x:Name="FpRemarks" TextWrapping="Wrap" Padding="6,3"/>
                <DockPanel Margin="0,8,0,4">
                  <Button DockPanel.Dock="Right" Content="Send amendment" Style="{StaticResource Primary}" Click="OnAmendClick"
                          ToolTip="Amend the flight plan for all controllers ($AM)"/>
                  <TextBlock x:Name="PlanDetails" TextWrapping="Wrap" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="AtcWindow" WindowId="atc" Header="CONTROLLERS">
          <ListBox x:Name="AtcList" FontFamily="{StaticResource MonoFont}" FontSize="12" MouseDoubleClick="OnAtcDoubleClick"
                   ToolTip="Double-click for a private message">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Frequency}" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Width="30" Style="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="ConflictsWindow" WindowId="conflicts" Header="CONFLICTS (STCA)">
          <ListBox x:Name="ConflictList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnConflictSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Separation}" Foreground="{DynamicResource DangerBrush}"/>
                  <TextBlock Text="{Binding Pair}" FontWeight="SemiBold"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="MessagesWindow" WindowId="messages" Header="MESSAGES">
          <DockPanel>
            <StackPanel x:Name="ChatTabs" Orientation="Horizontal" DockPanel.Dock="Top" Margin="2,0,0,2"/>
            <ListBox x:Name="ChatList" FontFamily="{StaticResource MonoFont}" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Text, Mode=OneWay}"/>
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>
      </Canvas>

      <!-- Map layers popup -->
      <Popup x:Name="LayersPopup" PlacementTarget="{Binding ElementName=LayersButton}" Placement="Bottom" StaysOpen="False"
             AllowsTransparency="True" Closed="OnLayersPopupClosed">
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,4,0,0" MinWidth="230" MaxHeight="560">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="MAP LAYERS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="LayerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Visible}" Checked="OnLayerToggled" Unchecked="OnLayerToggled"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <!-- Command bar: ASEL (selected aircraft) and the command line, as in EuroScope -->
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,4">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Width="150">
          <TextBlock Text="ASEL" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
          <TextBlock x:Name="AselText" Text="—" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource SelectBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock x:Name="RxText" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                     MaxWidth="420" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" ToolTip="Who is transmitting now"/>
          <Button x:Name="PttButton" Content="PTT" Style="{StaticResource MenuButton}" Margin="10,0,0,0" Visibility="Collapsed"
                  PreviewMouseLeftButtonDown="OnPttDown" PreviewMouseLeftButtonUp="OnPttUp" LostMouseCapture="OnPttLost"
                  ToolTip="Hold to talk (push-to-talk)"/>
          <!-- Primary frequency; turns red while transmitting. -->
          <Border x:Name="TxBadge" CornerRadius="3" Padding="6,1" Margin="6,0" VerticalAlignment="Center">
            <TextBlock x:Name="TxText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"/>
          </Border>
          <TextBlock x:Name="CursorText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Width="210"/>
        </StackPanel>
        <TextBox x:Name="CommandLine" FontFamily="{StaticResource MonoFont}" Padding="8,2" KeyDown="OnCommandKeyDown"
                 ToolTip="Message on the primary frequency or a .command (.help). Points picked on the radar go here."/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
