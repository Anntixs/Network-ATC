<Window x:Class="NetworkAtc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:radar="clr-namespace:NetworkAtc.App.Radar"
        Title="Network-ATC" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowState="Maximized" Style="{StaticResource AtcWindow}">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Text="Network-ATC" FontWeight="SemiBold" Margin="0,0,20,0"/>
          <TextBlock x:Name="StationText" Text="Не в сети" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
          <Button x:Name="ConnectButton" Click="OnConnectClick" Padding="12,4">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnectDot" Width="7" Height="7" Fill="{DynamicResource DangerBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="ConnectText" Text="Подключиться"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <ToggleButton x:Name="LayersButton" Content="Слои" Click="OnLayersClick"/>
          <ToggleButton x:Name="SideToggle" Content="Панель" IsChecked="True" Click="OnPanelsChanged"/>
          <ToggleButton x:Name="MessagesToggle" Content="Сообщения" IsChecked="True" Click="OnPanelsChanged"/>
          <Button Content="Сектор…" Click="OnOpenSectorClick"/>
          <Button Content="Настройки" Click="OnSettingsClick"/>
          <TextBlock x:Name="ClockText" FontFamily="{StaticResource MonoFont}" Margin="16,0,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="SideColumn" Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Radar and messages -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition x:Name="MessagesRow" Height="170"/>
        </Grid.RowDefinitions>

        <radar:RadarView x:Name="Radar"/>

        <!-- Floating status chips -->
        <Border Style="{StaticResource Card}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="10,6"
                IsHitTestVisible="False" Opacity="0.92">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="SectorText" Text="Нет сектора" Margin="0,0,12,0"/>
            <TextBlock x:Name="RangeText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="CursorText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,10"
                   Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" IsHitTestVisible="False"/>

        <!-- Layers popup -->
        <Popup x:Name="LayersPopup" PlacementTarget="{Binding ElementName=LayersButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" Closed="OnLayersPopupClosed">
          <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,6,0,0" MinWidth="220">
            <StackPanel>
              <TextBlock Text="СЛОИ КАРТЫ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="LayerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Visible}" Checked="OnLayerToggled" Unchecked="OnLayerToggled"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>

        <!-- Messages and command line -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <DockPanel Margin="14,6,14,10">
            <StackPanel x:Name="ChatTabs" Orientation="Horizontal" DockPanel.Dock="Top"/>
            <TextBox x:Name="CommandLine" DockPanel.Dock="Bottom" FontFamily="{StaticResource MonoFont}" Margin="0,6,0,0"
                     KeyDown="OnCommandKeyDown" ToolTip="Сообщение на основную частоту или .команда (.help)"/>
            <ListBox x:Name="ChatList" FontFamily="{StaticResource MonoFont}" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Text, Mode=OneWay}"/>
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Side panel -->
      <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <DockPanel Margin="14,8,14,14">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <RadioButton x:Name="TrafficTab" Content="Трафик" Style="{StaticResource Segment}" IsChecked="True" Checked="OnSideTabChanged"/>
            <RadioButton x:Name="PlanTab" Content="План" Style="{StaticResource Segment}" Checked="OnSideTabChanged"/>
            <RadioButton x:Name="AtcTab" Content="ATC" Style="{StaticResource Segment}" Checked="OnSideTabChanged"/>
          </StackPanel>

          <Grid>
            <!-- Traffic list -->
            <ListBox x:Name="TrafficList" SelectionChanged="OnTrafficSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="54"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Info}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Flight plan / strip of the selected aircraft -->
            <ScrollViewer x:Name="PlanPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="PlanEmpty" Text="Выберите борт на радаре" Style="{StaticResource Muted}" Margin="0,8"/>
                <StackPanel x:Name="PlanContent" Visibility="Collapsed">
                  <DockPanel>
                    <ToggleButton x:Name="TrackToggle" DockPanel.Dock="Right" Content="Сопровождать" Click="OnTrackToggle"/>
                    <TextBlock x:Name="PlanCallsign" FontSize="22" FontWeight="SemiBold"/>
                  </DockPanel>
                  <TextBlock x:Name="PlanSubtitle" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                  <TextBlock x:Name="PlanRoute" FontSize="16" Margin="0,12,0,0"/>

                  <TextBlock Text="УКАЗАНИЯ" Style="{StaticResource SectionTitle}"/>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,6">
                      <TextBlock Text="CFL" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                      <TextBox x:Name="CflBox" Tag="cfl" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,6">
                      <TextBlock Text="Курс" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                      <TextBox x:Name="HdgBox" Tag="hdg" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                      <TextBlock Text="Скорость" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                      <TextBox x:Name="SpdBox" Tag="spd" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,6">
                      <TextBlock Text="Код" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Выдать" Padding="8,5" Click="OnAssignSquawk"/>
                        <TextBox x:Name="SqBox" Tag="sq" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}"/>
                      </DockPanel>
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Text="Заметка" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="ScratchBox" Tag="scratch" KeyDown="OnAnnotationKeyDown"/>

                  <TextBlock Text="ПЛАН ПОЛЁТА" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="PlanDetails" TextWrapping="Wrap" LineHeight="20"/>
                  <TextBlock Text="Маршрут" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PlanRouteText" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="Примечания" Style="{StaticResource FieldLabel}"/>
                  <TextBlock x:Name="PlanRemarks" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- Controllers online -->
            <ListBox x:Name="AtcList" Visibility="Collapsed">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Frequency}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
