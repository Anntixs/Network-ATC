<Window x:Class="NetworkAtc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:radar="clr-namespace:NetworkAtc.App.Radar"
        xmlns:controls="clr-namespace:NetworkAtc.App.Controls"
        Title="Network-ATC" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowState="Maximized" Style="{StaticResource AtcWindow}">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <!-- Menu bar (EuroScope-style text menu, Aurora colors) -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
          <TextBlock Text="Network-ATC" FontWeight="SemiBold" Margin="0,0,14,0"/>
          <Button Content="СЕКТОР" Style="{StaticResource MenuButton}" Click="OnOpenSectorClick" ToolTip="Выбор сектора (Ctrl+O)"/>
          <ToggleButton x:Name="LayersButton" Content="КАРТЫ" Style="{StaticResource MenuToggle}" Click="OnLayersClick" ToolTip="Слои карты (F6)"/>
          <Button x:Name="ListsButton" Content="СПИСКИ ▾" Style="{StaticResource MenuButton}" Click="OnListsClick"/>
          <Button Content="НАСТРОЙКИ" Style="{StaticResource MenuButton}" Click="OnSettingsClick"/>
          <Border Width="1" Margin="10,8" Background="{DynamicResource BorderBrush}"/>
          <Button x:Name="ConnectButton" Click="OnConnectClick" Style="{StaticResource MenuButton}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnectDot" Width="7" Height="7" Fill="{DynamicResource DangerBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="ConnectText" Text="ПОДКЛЮЧИТЬСЯ"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="StationText" Text="" Style="{StaticResource Muted}" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock x:Name="SectorText" Text="Нет сектора" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
          <TextBlock x:Name="RangeText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" Margin="0,0,16,0"/>
          <TextBlock x:Name="ClockText" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>

    <!-- Radar with floating list windows -->
    <Grid Grid.Row="1">
      <radar:RadarView x:Name="Radar"/>
      <Canvas x:Name="WindowsLayer">

        <controls:FloatingPanel x:Name="DeparturesWindow" WindowId="departures" Header="ВЫЛЕТ">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="44"/><ColumnDefinition Width="46"/>
                <ColumnDefinition Width="54"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="ПОЗЫВНОЙ" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="1" Text="ТИП" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="2" Text="НАЗН" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="3" Text="RFL" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="4" Text="КОД" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="5" Text="СТАТУС" Style="{StaticResource ColumnHeader}"/>
            </Grid>
            <ListBox x:Name="DepartureList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80"/><ColumnDefinition Width="44"/><ColumnDefinition Width="46"/>
                      <ColumnDefinition Width="54"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Destination}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Rfl}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Squawk}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Status}" Style="{StaticResource Muted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="ArrivalsWindow" WindowId="arrivals" Header="ПРИЛЁТ">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="44"/><ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="ПОЗЫВНОЙ" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="1" Text="ТИП" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="2" Text="ОТКУДА" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="3" Text="КУДА" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="4" Text="NM" Style="{StaticResource ColumnHeader}"/>
              <TextBlock Grid.Column="5" Text="ETA" Style="{StaticResource ColumnHeader}"/>
            </Grid>
            <ListBox x:Name="ArrivalList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80"/><ColumnDefinition Width="44"/><ColumnDefinition Width="46"/>
                      <ColumnDefinition Width="46"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Departure}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Destination}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Distance}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Eta}" Style="{StaticResource Muted}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="TrafficWindow" WindowId="traffic" Header="ВЕСЬ ТРАФИК">
          <ListBox x:Name="TrafficList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnListSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Level}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Info}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="FlightPlanWindow" WindowId="flightplan" Header="ПЛАН ПОЛЁТА">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0">
            <StackPanel>
              <TextBlock x:Name="PlanEmpty" Text="Выберите борт на радаре" Style="{StaticResource Muted}" Margin="2,6"/>
              <StackPanel x:Name="PlanContent" Visibility="Collapsed">
                <DockPanel>
                  <ToggleButton x:Name="TrackToggle" DockPanel.Dock="Right" Content="Сопровождать" Style="{StaticResource MenuToggle}" Click="OnTrackToggle"/>
                  <TextBlock x:Name="PlanCallsign" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </DockPanel>
                <TextBlock x:Name="PlanSubtitle" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
                <TextBlock x:Name="PlanRoute" FontSize="15" Margin="0,8,0,0"/>

                <TextBlock Text="УКАЗАНИЯ" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="CFL" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="CflBox" Tag="cfl" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="Курс" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="HdgBox" Tag="hdg" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,4,4">
                    <TextBlock Text="Скорость" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox x:Name="SpdBox" Tag="spd" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                  </StackPanel>
                  <StackPanel Margin="4,0,0,4">
                    <TextBlock Text="Код" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Выдать" Padding="6,3" Click="OnAssignSquawk"/>
                      <TextBox x:Name="SqBox" Tag="sq" KeyDown="OnAnnotationKeyDown" FontFamily="{StaticResource MonoFont}" Padding="6,3"/>
                    </DockPanel>
                  </StackPanel>
                </UniformGrid>
                <TextBlock Text="Заметка" Style="{StaticResource FieldLabel}" Margin="0,2,0,2"/>
                <TextBox x:Name="ScratchBox" Tag="scratch" KeyDown="OnAnnotationKeyDown" Padding="6,3"/>

                <TextBlock Text="ПЛАН" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                <TextBlock x:Name="PlanDetails" TextWrapping="Wrap" LineHeight="18"/>
                <TextBlock Text="Маршрут" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="PlanRouteText" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="Примечания" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="PlanRemarks" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="AtcWindow" WindowId="atc" Header="ДИСПЕТЧЕРЫ">
          <ListBox x:Name="AtcList" FontFamily="{StaticResource MonoFont}" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Frequency}" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="ConflictsWindow" WindowId="conflicts" Header="КОНФЛИКТЫ (STCA)">
          <ListBox x:Name="ConflictList" FontFamily="{StaticResource MonoFont}" FontSize="12" SelectionChanged="OnConflictSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Separation}" Foreground="{DynamicResource DangerBrush}"/>
                  <TextBlock Text="{Binding Pair}" FontWeight="SemiBold"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </controls:FloatingPanel>

        <controls:FloatingPanel x:Name="MessagesWindow" WindowId="messages" Header="СООБЩЕНИЯ">
          <DockPanel>
            <StackPanel x:Name="ChatTabs" Orientation="Horizontal" DockPanel.Dock="Top" Margin="2,0,0,2"/>
            <ListBox x:Name="ChatList" FontFamily="{StaticResource MonoFont}" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Foreground="{Binding Brush}">
                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                    <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="{Binding Text, Mode=OneWay}"/>
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </controls:FloatingPanel>
      </Canvas>

      <!-- Map layers popup -->
      <Popup x:Name="LayersPopup" PlacementTarget="{Binding ElementName=LayersButton}" Placement="Bottom" StaysOpen="False"
             AllowsTransparency="True" Closed="OnLayersPopupClosed">
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,4,0,0" MinWidth="230" MaxHeight="560">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="СЛОИ КАРТЫ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="LayerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Visible}" Checked="OnLayerToggled" Unchecked="OnLayerToggled"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <!-- Command bar: ASEL (selected aircraft) and the command line, as in EuroScope -->
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,4">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Width="150">
          <TextBlock Text="ASEL" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
          <TextBlock x:Name="AselText" Text="—" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="#F2C94C"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock x:Name="TxText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" Margin="12,0"/>
          <TextBlock x:Name="CursorText" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11" Width="210"/>
        </StackPanel>
        <TextBox x:Name="CommandLine" FontFamily="{StaticResource MonoFont}" Padding="8,2" KeyDown="OnCommandKeyDown"
                 ToolTip="Сообщение на основную частоту или .команда (.help). Точка на радаре — сюда."/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
