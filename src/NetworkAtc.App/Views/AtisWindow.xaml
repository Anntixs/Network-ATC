<Window x:Class="NetworkAtc.App.Views.AtisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATIS" Width="880" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AtcWindow}">
  <DockPanel Margin="16,14,16,14">
    <DockPanel DockPanel.Dock="Left" Width="210" Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Top" Text="Станции ATIS" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="+ Добавить" Click="OnAdd" Margin="0,0,6,0"/>
        <Button x:Name="RemoveButton" Content="Удалить" Click="OnRemove"/>
      </StackPanel>
      <ListBox x:Name="StationList" SelectionChanged="OnStationSelected" FontFamily="{StaticResource MonoFont}"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Editor"/>
    </ScrollViewer>
  </DockPanel>
</Window>
