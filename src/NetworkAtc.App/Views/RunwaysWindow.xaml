<Window x:Class="NetworkAtc.App.Views.RunwaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active airports and runways" Width="520" Height="560" MinHeight="300"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AtcWindow}">
  <DockPanel Margin="20,16,20,18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Airports and runways" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                 Text="Checked airports appear in the departure and arrival lists. SIDs and STARs are chosen by runway; arrival runways get an extended centerline."/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Apply" IsDefault="True" Style="{StaticResource Primary}" Click="OnOk"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Body"/>
    </ScrollViewer>
  </DockPanel>
</Window>
