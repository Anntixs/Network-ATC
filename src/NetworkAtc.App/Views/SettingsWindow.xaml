<Window x:Class="NetworkAtc.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="920" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AtcWindow}">
  <DockPanel>
    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button Content="Save" IsDefault="True" Style="{StaticResource Primary}" Click="OnSave"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="10,16">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,14"/>
        <ListBox x:Name="Nav" SelectionChanged="OnNavChanged">
          <ListBoxItem Content="Theme and colors"/>
          <ListBoxItem Content="Interface"/>
          <ListBoxItem Content="Tags"/>
          <ListBoxItem Content="Targets and map"/>
          <ListBoxItem Content="STCA, squawks, CLAM"/>
          <ListBoxItem Content="Hotkeys"/>
          <ListBoxItem Content="Aliases and ATIS"/>
          <ListBoxItem Content="Plugins"/>
        </ListBox>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,20,28,20">
        <!-- 0: theme -->
        <StackPanel x:Name="Page0">
          <TextBlock Text="Theme and colors" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Every radar and interface color can be changed. The theme is saved in the profile and can be exported to JSON." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="PROFILE" Style="{StaticResource SectionTitle}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>
          <TextBlock Text="PRESET THEMES" Style="{StaticResource SectionTitle}"/>
          <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="PresetBox" Width="200" DisplayMemberPath="Name"/>
            <Button Content="Apply" Margin="8,0,0,0" Click="OnApplyPreset"/>
            <Button Content="Import…" Click="OnImportTheme"/>
            <Button Content="Export…" Click="OnExportTheme"/>
          </StackPanel>
          <CheckBox Content="Take map colors from the sector file (#define)" IsChecked="{Binding UseSectorFileColors}" Margin="0,12,0,0"/>
          <TextBlock Text="COLORS" Style="{StaticResource SectionTitle}"/>
          <ItemsControl x:Name="ColorList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,16,6">
                  <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5" Background="{Binding Brush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                  <TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 1: interface -->
        <StackPanel x:Name="Page1" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Text="Interface" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Interface font size" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.UiFontSize}"/>
          <TextBlock Text="Interface scale (1 = 100 %)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.UiScale}"/>
          <TextBlock Text="Active airports (space-separated)" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="AirportsBox" CharacterCasing="Upper" ToolTip="Departure and arrival lists are built from these airports; same as the .airport command"/>
          <CheckBox Content="Sector selection window at startup" IsChecked="{Binding ShowSectorSelection}" Margin="0,14,0,0"/>
          <CheckBox Content="Open flight plan when selecting an aircraft" IsChecked="{Binding Panels.ShowFlightPlan}"/>
          <CheckBox x:Name="ResetWindowsBox" Content="Reset list window layout" Margin="0,14,0,0"/>
          <CheckBox Content="Fetch METAR for active airports (aviationweather.gov)" IsChecked="{Binding FetchMetar}" Margin="0,8,0,0"/>

          <TextBlock Text="SOUNDS" Style="{StaticResource SectionTitle}"/>
          <CheckBox Content="Sounds enabled" IsChecked="{Binding Sounds.Enabled}" FontWeight="SemiBold"/>
          <UniformGrid Columns="2" Margin="0,4,0,0">
            <CheckBox Content="Frequency message" IsChecked="{Binding Sounds.RadioMessage}"/>
            <CheckBox Content="Private message" IsChecked="{Binding Sounds.PrivateMessage}"/>
            <CheckBox Content="Incoming handoff" IsChecked="{Binding Sounds.HandoffRequest}"/>
            <CheckBox Content="Handoff accepted" IsChecked="{Binding Sounds.HandoffAccepted}"/>
            <CheckBox Content="Handoff refused" IsChecked="{Binding Sounds.HandoffRefused}"/>
            <CheckBox Content="Point-out" IsChecked="{Binding Sounds.PointOut}"/>
            <CheckBox Content="Conflict (STCA)" IsChecked="{Binding Sounds.ConflictAlert}"/>
            <CheckBox Content="Connect / disconnect" IsChecked="{Binding Sounds.Connection}"/>
          </UniformGrid>
          <TextBlock Text="Volume (0–1)" Style="{StaticResource FieldLabel}"/>
          <Slider Minimum="0" Maximum="1" Value="{Binding Sounds.Volume}" Width="220" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 2: tags -->
        <Grid x:Name="Page2" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="250"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Tags" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Fields go in curly braces: {callsign}. {cfl|---} shows &quot;---&quot; when the field is empty. Each template line is a tag line." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Untracked aircraft" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Untracked, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <TextBlock Text="Tracked aircraft" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Tracked, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <TextBlock Text="Lines on mouse hover (appended below)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Detailed, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <CheckBox Content="Warnings (EMERG, CLAM, DUPE, SQ) above the tag" IsChecked="{Binding Tags.ShowWarnings}" Margin="0,8,0,0"/>
            <UniformGrid Columns="2" Margin="0,4,0,0">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Font" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.FontFamily}"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.FontSize}"/>
              </StackPanel>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Offset X" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.DefaultOffsetX}"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Offset Y" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.DefaultOffsetY}"/>
              </StackPanel>
            </UniformGrid>
            <CheckBox Content="Leader line from target to tag" IsChecked="{Binding Tags.ShowTagLeader}" Margin="0,12,0,0"/>
            <TextBlock Text="TAG FIELD CLICKS" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="What a left and right click does on each tag field." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Field" Style="{StaticResource Muted}"/>
              <TextBlock Grid.Column="1" Text="Left click" Style="{StaticResource Muted}"/>
              <TextBlock Grid.Column="3" Text="Right click" Style="{StaticResource Muted}"/>
            </Grid>
            <ItemsControl x:Name="ClickList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Field, StringFormat={}{{{0}}}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Actions}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Left}"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Actions}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Right}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Reset clicks to defaults" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnResetClicks"/>
            <TextBlock Text="PREVIEW" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="14,10" Background="{DynamicResource BgBrush}">
              <TextBlock x:Name="TagPreview" FontFamily="{StaticResource MonoFont}" LineHeight="18"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="AVAILABLE FIELDS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <ItemsControl x:Name="FieldList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Key, StringFormat={}{{{0}}}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- 3: targets and map -->
        <StackPanel x:Name="Page3" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Targets and map" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="TARGETS" Style="{StaticResource SectionTitle}"/>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="History dots" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.HistoryDots}"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <TextBlock Text="Prediction, min" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.PredictionMinutes}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Symbol size" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.SymbolSize}"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Filter: from, ft" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.FilterFloor}"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <TextBlock Text="Filter: to, ft" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.FilterCeiling}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Transition altitude, ft" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TransitionAltitude}"/>
            </StackPanel>
          </UniformGrid>
          <CheckBox Content="Show ground traffic" IsChecked="{Binding Targets.ShowGroundTraffic}" Margin="0,12,0,0"/>
          <TextBlock Text="MAP" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Sector file (.natc or .sct)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseSector" Margin="8,0,0,0"/>
            <TextBox Text="{Binding SectorFile}"/>
          </DockPanel>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Range ring spacing, NM" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RangeRingSpacingNm}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Number of rings" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RangeRingCount}"/>
            </StackPanel>
          </UniformGrid>
        </StackPanel>

        <!-- 4: STCA -->
        <StackPanel x:Name="Page4" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Text="STCA, squawks, CLAM" FontSize="20" FontWeight="SemiBold"/>
          <CheckBox Content="Conflict alert (STCA)" IsChecked="{Binding StcaEnabled}" Margin="0,14,0,0"/>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Horizontal, NM" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding StcaHorizontalNm}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Vertical, ft" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding StcaVerticalFeet}"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Squawk range for .sq" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SquawkRange}" Width="160" HorizontalAlignment="Left"/>
          <TextBlock Text="If your position has its own squawk range in the .ese, that range is used." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="CLAM: deviation from cleared altitude, ft" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding ClamFeet}" Width="160" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 5: keys -->
        <StackPanel x:Name="Page5" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Hotkeys" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Click a field and press the key combination. Backspace clears it." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
          <ItemsControl x:Name="KeyList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <TextBox DockPanel.Dock="Right" Width="180" Text="{Binding Gesture}" IsReadOnly="True"
                           PreviewKeyDown="OnGestureKeyDown" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="{Binding Title}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 6: aliases -->
        <StackPanel x:Name="Page6" Visibility="Collapsed">
          <TextBlock Text="Aliases and info" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="One per line: .ctc = contact $1 on $2, good day. $1, $2… are the words after the alias, $cs is the selected aircraft." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
          <TextBox x:Name="AliasBox" AcceptsReturn="True" Height="260" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto"/>
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Variables: $aircraft $type $dep $arr $alt $cfl $squawk $route $sid $star $deprwy $arrrwy $calt $nextctr $nextfreq $mycallsign $myfreq $myrealname $myairport $time $metar(UUEE) $wind(UUEE) $qnh(UUEE) $altim(UUEE) $atiscode(UUEE)"/>
          <TextBlock Text="CONTROLLER INFO" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Pilots receive these lines on request (like the ATIS in EuroScope). Variables work here too." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBox x:Name="ControllerInfoBox" AcceptsReturn="True" Height="110" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- 7: plugins -->
        <StackPanel x:Name="Page7" Visibility="Collapsed">
          <TextBlock Text="Plugins" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Plugins are .NET 8 assemblies with an IAtcPlugin class in the plugins folder. See examples/SamplePlugin in the repository." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <Button Content="Open plugins folder" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenPluginsFolder"/>
          <TextBlock Text="LOADED" Style="{StaticResource SectionTitle}"/>
          <ItemsControl x:Name="PluginList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
