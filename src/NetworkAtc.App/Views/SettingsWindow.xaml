<Window x:Class="NetworkAtc.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="920" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AtcWindow}">
  <DockPanel>
    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
          <Button Content="Сохранить" IsDefault="True" Style="{StaticResource Primary}" Click="OnSave"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="10,16">
        <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,14"/>
        <ListBox x:Name="Nav" SelectionChanged="OnNavChanged">
          <ListBoxItem Content="Тема и цвета"/>
          <ListBoxItem Content="Интерфейс"/>
          <ListBoxItem Content="Теги"/>
          <ListBoxItem Content="Цели и карта"/>
          <ListBoxItem Content="STCA и коды"/>
          <ListBoxItem Content="Горячие клавиши"/>
          <ListBoxItem Content="Алиасы"/>
          <ListBoxItem Content="Плагины"/>
        </ListBox>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,20,28,20">
        <!-- 0: theme -->
        <StackPanel x:Name="Page0">
          <TextBlock Text="Тема и цвета" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Каждый цвет радара и интерфейса можно изменить. Тема сохраняется в профиле и экспортируется в JSON." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource SectionTitle}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>
          <TextBlock Text="ГОТОВЫЕ ТЕМЫ" Style="{StaticResource SectionTitle}"/>
          <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="PresetBox" Width="200" DisplayMemberPath="Name"/>
            <Button Content="Применить" Margin="8,0,0,0" Click="OnApplyPreset"/>
            <Button Content="Импорт…" Click="OnImportTheme"/>
            <Button Content="Экспорт…" Click="OnExportTheme"/>
          </StackPanel>
          <CheckBox Content="Цвета карты брать из файла сектора (#define)" IsChecked="{Binding UseSectorFileColors}" Margin="0,12,0,0"/>
          <TextBlock Text="ЦВЕТА" Style="{StaticResource SectionTitle}"/>
          <ItemsControl x:Name="ColorList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,16,6">
                  <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="5" Background="{Binding Brush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                  <TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 1: interface -->
        <StackPanel x:Name="Page1" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Text="Интерфейс" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Размер шрифта интерфейса" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.UiFontSize}"/>
          <TextBlock Text="Масштаб интерфейса (1 = 100 %)" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.UiScale}"/>
          <TextBlock Text="Ширина боковой панели, px" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.SidePanelWidth}"/>
          <TextBlock Text="Высота панели сообщений, px" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Panels.MessagesHeight}"/>
          <CheckBox Content="Показывать боковую панель" IsChecked="{Binding Panels.ShowAircraftList}" Margin="0,14,0,0"/>
          <CheckBox Content="Показывать сообщения" IsChecked="{Binding Panels.ShowMessages}"/>
          <CheckBox Content="Открывать план полёта при выборе борта" IsChecked="{Binding Panels.ShowFlightPlan}"/>
        </StackPanel>

        <!-- 2: tags -->
        <Grid x:Name="Page2" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="250"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Теги" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Поля пишутся в фигурных скобках: {callsign}. {cfl|---} покажет «---», если поле пустое. Каждая строка шаблона — строка тега." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Борт без сопровождения" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Untracked, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <TextBlock Text="Борт на сопровождении" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Tracked, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <TextBlock Text="Выбранный борт (подробный)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Tags.Detailed, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" FontFamily="{StaticResource MonoFont}" TextChanged="OnTagChanged" VerticalContentAlignment="Top"/>
            <UniformGrid Columns="2" Margin="0,4,0,0">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Шрифт" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.FontFamily}"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Размер" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.FontSize}"/>
              </StackPanel>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Смещение X" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.DefaultOffsetX}"/>
              </StackPanel>
              <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Смещение Y" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Tags.DefaultOffsetY}"/>
              </StackPanel>
            </UniformGrid>
            <CheckBox Content="Линия от цели к тегу" IsChecked="{Binding Tags.ShowTagLeader}" Margin="0,12,0,0"/>
            <TextBlock Text="ПРЕДПРОСМОТР" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="14,10" Background="{DynamicResource BgBrush}">
              <TextBlock x:Name="TagPreview" FontFamily="{StaticResource MonoFont}" LineHeight="18"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ДОСТУПНЫЕ ПОЛЯ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <ItemsControl x:Name="FieldList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding Key, StringFormat={}{{{0}}}}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- 3: targets and map -->
        <StackPanel x:Name="Page3" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Цели и карта" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="ЦЕЛИ" Style="{StaticResource SectionTitle}"/>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Точек истории" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.HistoryDots}"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <TextBlock Text="Прогноз, мин" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.PredictionMinutes}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Размер символа" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.SymbolSize}"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Фильтр: от, фт" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.FilterFloor}"/>
            </StackPanel>
            <StackPanel Margin="4,0">
              <TextBlock Text="Фильтр: до, фт" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Targets.FilterCeiling}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Эшелон перехода, фт" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TransitionAltitude}"/>
            </StackPanel>
          </UniformGrid>
          <CheckBox Content="Показывать борты на земле" IsChecked="{Binding Targets.ShowGroundTraffic}" Margin="0,12,0,0"/>
          <TextBlock Text="КАРТА" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Файл сектора (.sct)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Обзор…" Click="OnBrowseSector" Margin="8,0,0,0"/>
            <TextBox Text="{Binding SectorFile}"/>
          </DockPanel>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="Шаг колец дальности, NM" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RangeRingSpacingNm}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Число колец" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding RangeRingCount}"/>
            </StackPanel>
          </UniformGrid>
        </StackPanel>

        <!-- 4: STCA -->
        <StackPanel x:Name="Page4" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
          <TextBlock Text="STCA и коды" FontSize="20" FontWeight="SemiBold"/>
          <CheckBox Content="Предупреждение о конфликтах (STCA)" IsChecked="{Binding StcaEnabled}" Margin="0,14,0,0"/>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Text="По горизонтали, NM" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding StcaHorizontalNm}"/>
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="По вертикали, фт" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding StcaVerticalFeet}"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="Диапазон кодов ответчика для .sq" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SquawkRange}" Width="160" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 5: keys -->
        <StackPanel x:Name="Page5" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Щёлкните поле и нажмите нужное сочетание. Backspace — очистить." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
          <ItemsControl x:Name="KeyList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <TextBox DockPanel.Dock="Right" Width="180" Text="{Binding Gesture}" IsReadOnly="True"
                           PreviewKeyDown="OnGestureKeyDown" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="{Binding Title}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 6: aliases -->
        <StackPanel x:Name="Page6" Visibility="Collapsed">
          <TextBlock Text="Алиасы" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="По одному на строку: .ctc = contact $1 on $2, good day. $1, $2… — слова после алиаса, $cs — выбранный борт." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
          <TextBox x:Name="AliasBox" AcceptsReturn="True" Height="360" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- 7: plugins -->
        <StackPanel x:Name="Page7" Visibility="Collapsed">
          <TextBlock Text="Плагины" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Плагины — .NET 8 сборки с классом IAtcPlugin в папке plugins. Пример — в репозитории, examples/SamplePlugin." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <Button Content="Открыть папку плагинов" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenPluginsFolder"/>
          <TextBlock Text="ЗАГРУЖЕНЫ" Style="{StaticResource SectionTitle}"/>
          <ItemsControl x:Name="PluginList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
