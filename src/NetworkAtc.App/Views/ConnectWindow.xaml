<Window x:Class="NetworkAtc.App.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AtcWindow}">
  <StackPanel Margin="24,18,24,22">
    <TextBlock Text="Go on the air" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="A sector position fills in the callsign and frequency" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

    <TextBlock Text="STATION" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="Sector position" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
    <ComboBox x:Name="PositionBox" DisplayMemberPath="Display" SelectionChanged="OnPositionSelected"/>
    <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Callsign" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CallsignBox" CharacterCasing="Upper" MaxLength="12" TextChanged="OnCallsignChanged"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Frequency" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="FrequencyBox"/>
      </StackPanel>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Facility" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FacilityBox"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Rating" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RatingBox"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
        <TextBlock Text="Range, NM" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RangeBox"/>
      </StackPanel>
    </Grid>

    <TextBlock Text="NETWORK" Style="{StaticResource SectionTitle}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Server" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="ServerBox" ToolTip="host or host:port"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="CID" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="CidBox"/>
      </StackPanel>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordBox"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Connect" IsDefault="True" Style="{StaticResource Primary}" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
